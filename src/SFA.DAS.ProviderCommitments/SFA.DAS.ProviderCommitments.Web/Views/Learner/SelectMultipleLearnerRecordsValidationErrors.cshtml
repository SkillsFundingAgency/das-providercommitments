@inject ILinkGenerator LinkGenerator;
@model SFA.DAS.ProviderCommitments.Web.Models.Learners.SelectMultipleLearnerRecordsValidationErrorsViewModel;

@{
    ViewData["Title"] = "Select multiple learner records validation errors";
    ViewBag.GaData.Vpv = "/unapproved/add/select-multiple-learner/validate";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <div class="govuk-error-summary" aria-labelledby="error-summary-title" role="alert" tabindex="-1"
             data-module="error-summary">
            <h2 class="govuk-error-summary__title" id="error-summary-title">
                There is a problem
            </h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    <li>
                        <a href="#file-error-error" data-focuses="#file-error-error">You need to correct the errors ....?</a>
                    </li>
                </ul>
            </div>
        </div>

        <h1 class="govuk-heading-l  govuk-!-margin-top-4">There is a problem with learner records</h1>

        <div class="govuk-warning-text">
            <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
            <strong class="govuk-warning-text__text">
                <span class="govuk-visually-hidden govuk-warning-text__assistive">Warning</span>
                You will need to correct the errors in ....?
            </strong>
        </div>
        <div class="govuk-form-group govuk-form-group--error">
            <h2 class="govuk-heading-m  govuk-!-margin-top-4">Your records have the following errors </h2>
            <table class="govuk-table">
                <caption class="govuk-table__caption govuk-table__caption--s govuk-!-margin-bottom-4 govuk-error-message">
                    <span id="file-error-error" class="govuk-error-message">
                        <span class="govuk-visually-hidden">Error:</span>You need to correct the errors and ...?
                    </span>
                </caption>

                <thead class="govuk-table__head">
                    <tr class="govuk-table__row">                        
                        <th scope="col" class="govuk-table__header">Employer</th>
                        <th scope="col" class="govuk-table__header">ULN</th>
                        <th scope="col" class="govuk-table__header">Name</th>
                        <th scope="col" class="govuk-table__header">Errors</th>
                    </tr>
                </thead>
                <tbody class="govuk-table__body">
                    @foreach (var error in Model.ValidationErrors)
                    {
                        <tr class="govuk-table__row">                            
                            <td class="govuk-table__cell">@error.EmployerName</td>
                            <td class="govuk-table__cell">@error.Uln</td>
                            <td class="govuk-table__cell">@error.ApprenticeName</td>
                            <td class="govuk-table__cell">
                                <ul class="govuk-list">
                                    @foreach (var pError in error.Errors)
                                    {
                                        <li>@Html.Raw(System.Net.WebUtility.HtmlDecode(pError.ErrorText))</li>
                                    }
                                </ul>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section breadcrumb
{
    <a id="back-link" class="govuk-back-link" href="@Url.Action("FileUploadStart", new { @Model.ProviderId })">Back</a>
}