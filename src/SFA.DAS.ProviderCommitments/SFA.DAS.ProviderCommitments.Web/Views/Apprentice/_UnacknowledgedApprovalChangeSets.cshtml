@using SFA.DAS.ProviderCommitments.Web.Validators.Apprentice
@model SFA.DAS.ProviderCommitments.Web.Models.Apprentice.InvalidIlrChangesViewModel

@for (var i = 0; i < Model.RequestSets.Count; i++)
{
    var set = Model.RequestSets[i];
    var deleteAlertField = $"RequestSets[{i}].DeleteAlert";
    var errorId = $"error-message-RequestSets_{i}__DeleteAlert";
    var deleteRadioId = $"RequestSets_{i}__DeleteAlert";
    var keepRadioId = $"RequestSets_{i}__DeleteAlert-no";
    var deleteHintId = $"{deleteRadioId}-hint";
    var legendHintId = $"legend-hint-{i}";
    var hasDeleteAlertError = ViewData.ModelState[deleteAlertField]?.Errors.Count > 0;
    var tableCaption = set.Fields.Count == 1
        ? set.Fields[0].FieldDisplayName
        : Model.RequestSets.Count == 1
            ? Model.ChangeSetCaption
            : $"{Model.ChangeSetCaptionPrefix} {i + 1} of {Model.RequestSets.Count}";
    var describedBy = hasDeleteAlertError && !string.IsNullOrEmpty(Model.LegendHint)
        ? $"{legendHintId} {errorId}"
        : hasDeleteAlertError
            ? errorId
            : !string.IsNullOrEmpty(Model.LegendHint)
                ? legendHintId
                : null;

    <input type="hidden" name="RequestSets[@i].ApprovalRequestId" value="@set.ApprovalRequestId" />

    <div class="govuk-!-margin-bottom-8">
        <table class="govuk-table">
            <caption class="govuk-table__caption govuk-table__caption--m">
                <span class="govuk-visually-hidden">@tableCaption</span>
            </caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header">@Model.FieldColumnHeader</th>
                    <th scope="col" class="govuk-table__header">Current</th>
                    <th scope="col" class="govuk-table__header">@Model.NewValueColumnHeader</th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var field in set.Fields)
                {
                    <tr class="govuk-table__row">
                        <th scope="row" class="govuk-table__header">@field.FieldDisplayName</th>
                        <td class="govuk-table__cell">@field.Old</td>
                        <td class="govuk-table__cell">@field.New</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="govuk-form-group @(hasDeleteAlertError ? "govuk-form-group--error" : null)">
            <fieldset class="govuk-fieldset" aria-describedby="@describedBy">
                <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                    Do you want to delete this alert?
                    @if (Model.RequestSets.Count > 1)
                    {
                        <span class="govuk-visually-hidden">@tableCaption</span>
                    }
                </legend>
                @if (!string.IsNullOrEmpty(Model.LegendHint))
                {
                    <div id="@legendHintId" class="govuk-hint">
                        @Model.LegendHint
                    </div>
                }
                @if (hasDeleteAlertError)
                {
                    <p class="govuk-error-message" id="@errorId">
                        <span class="govuk-visually-hidden">Error:</span>
                        @InvalidIlrChangesViewModelValidator.SelectDeleteMessage
                    </p>
                }
                <div class="govuk-radios" data-module="govuk-radios">
                    <div class="govuk-radios__item">
                        <input class="govuk-radios__input"
                               id="@deleteRadioId"
                               name="@deleteAlertField"
                               type="radio"
                               value="true"
                               aria-describedby="@deleteHintId"
                               @(set.DeleteAlert == true ? "checked" : null) />
                        <label class="govuk-label govuk-radios__label" for="@deleteRadioId">
                            Yes, delete the alert
                        </label>
                        <div id="@deleteHintId" class="govuk-hint govuk-radios__hint">
                            If you do not delete all alerts for this learner, you will still see an alert on your Manage your learners page.
                        </div>
                    </div>
                    <div class="govuk-radios__item">
                        <input class="govuk-radios__input"
                               id="@keepRadioId"
                               name="@deleteAlertField"
                               type="radio"
                               value="false"
                               @(set.DeleteAlert == false ? "checked" : null) />
                        <label class="govuk-label govuk-radios__label" for="@keepRadioId">
                            No, keep the alert
                        </label>
                    </div>
                </div>
            </fieldset>
        </div>
    </div>
}
