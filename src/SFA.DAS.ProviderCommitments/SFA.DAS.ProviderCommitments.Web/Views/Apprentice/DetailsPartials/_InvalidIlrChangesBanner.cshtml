@model SFA.DAS.ProviderCommitments.Web.Models.Apprentice.DetailsViewModel
@using SFA.DAS.ProviderCommitments.Web.RouteValues

@if (Model.HasUnacknowledgedInvalidIlrChanges)
{
    <div class="govuk-notification-banner" role="region" aria-labelledby="invalid-ilr-changes-banner-title"
         data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="invalid-ilr-changes-banner-title">
                Action needed
            </h2>
        </div>
        <div class="govuk-notification-banner__content">
            <h3 class="govuk-notification-banner__heading">
                Invalid changes made in ILR
            </h3>
            <p class="govuk-body">
                Some changes you have made have been automatically rejected. This is because one or more fields in the ILR file were invalid.
            </p>
            <p class="govuk-body">
                <a class="govuk-notification-banner__link" asp-route="@RouteNames.InvalidIlrChanges"
                   asp-route-providerId="@Model.ProviderId"
                   asp-route-apprenticeshipHashedId="@Model.ApprenticeshipHashedId">
                    View invalid changes
                </a>
            </p>
        </div>
    </div>
}
